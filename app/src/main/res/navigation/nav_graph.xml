<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/inicioFragment">

    <fragment
        android:id="@+id/inicioFragment"
        android:name="com.dam.cafepunto.ui.inicio.InicioFragment"
        tools:layout="@layout/fragment_inicio">

        <action
            android:id="@+id/accion_inicio_a_login"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/accion_inicio_a_registro"
            app:destination="@id/registroFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.dam.cafepunto.ui.login.LoginFragment"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/accion_login_a_registro"
            app:destination="@id/registroFragment" />
        <action
            android:id="@+id/accion_login_a_recuperar"
            app:destination="@id/recuperarFragment" />
        <!-- Tras autenticarse se limpia la pila para no volver al login con "Atrás" -->
        <action
            android:id="@+id/accion_login_a_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registroFragment"
        android:name="com.dam.cafepunto.ui.registro.RegistroFragment"
        tools:layout="@layout/fragment_registro">

        <action
            android:id="@+id/accion_registro_a_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/inicioFragment" />
    </fragment>

    <fragment
        android:id="@+id/recuperarFragment"
        android:name="com.dam.cafepunto.ui.recuperar.RecuperarFragment"
        tools:layout="@layout/fragment_recuperar">

        <action
            android:id="@+id/accion_recuperar_a_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.dam.cafepunto.ui.home.HomeFragment"
        tools:layout="@layout/fragment_home" />

</navigation>
