<?xml version="1.0" encoding="utf-8"?>
<!-- Registro en horizontal (landscape): logo y título más pequeños y campos en dos columnas -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/registro_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".fragments.RegistroFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/registro_guia_centro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <ImageView
            android:id="@+id/registro_imagen_logo"
            android:layout_width="56dp"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/logo"
            app:layout_constraintEnd_toStartOf="@id/registro_texto_titulo"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/icono_cafe" />

        <TextView
            android:id="@+id/registro_texto_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/nombre_app"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/registro_imagen_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/registro_imagen_logo"
            app:layout_constraintTop_toTopOf="@id/registro_imagen_logo" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/registro_campo_nombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:hint="@string/nombre"
            app:layout_constraintEnd_toStartOf="@id/registro_guia_centro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/registro_imagen_logo">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/registro_texto_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/registro_campo_correo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="32dp"
            android:hint="@string/correo_electronico"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/registro_guia_centro"
            app:layout_constraintTop_toBottomOf="@id/registro_imagen_logo">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/registro_texto_correo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/registro_campo_contrasena"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="32dp"
            android:hint="@string/contrasena"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/registro_campo_nombre">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/registro_texto_contrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/registro_boton_registrate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="@string/registrate"
            app:layout_constraintEnd_toEndOf="@id/registro_campo_contrasena"
            app:layout_constraintStart_toStartOf="@id/registro_campo_contrasena"
            app:layout_constraintTop_toBottomOf="@id/registro_campo_contrasena" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
