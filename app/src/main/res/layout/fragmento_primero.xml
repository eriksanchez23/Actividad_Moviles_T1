<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Primer_Fragmento">

    <ImageView
        android:id="@+id/inicio_imagen_logo"
        android:layout_width="168dp"
        android:layout_height="139dp"
        android:contentDescription="@string/logo"
        app:layout_constraintBottom_toTopOf="@+id/inicio_imagen_carga"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/icono_cafe" />

    <ImageView
        android:id="@+id/inicio_imagen_carga"
        android:layout_width="147dp"
        android:layout_height="147dp"
        android:layout_marginTop="32dp"
        android:contentDescription="@string/icono_cargando"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/inicio_imagen_logo"
        app:srcCompat="@drawable/icono_carga" />

    <Button
        android:id="@+id/inicio_boton_iniciar_sesion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="@string/iniciar_sesion"
        app:layout_constraintBottom_toTopOf="@+id/inicio_boton_registrate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/inicio_imagen_carga" />

    <Button
        android:id="@+id/inicio_boton_registrate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/registrate"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/inicio_imagen_carga" />

</androidx.constraintlayout.widget.ConstraintLayout>
